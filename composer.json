{
    "name": "masterpuffin/payment-gateways",
    "type": "library",
    "license": "MIT",
    "version": "4.2.0",
    "autoload": {
        "psr-4": {
            "MasterPuffin\\PaymentGateways\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MasterPuffin\\PaymentGateways\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Johannes Bluhm",
