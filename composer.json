        "stripe/stripe-php": "^22.0",
        "paypal/paypal-server-sdk": "^2.4",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "nyholm/psr7": "^1.8"
